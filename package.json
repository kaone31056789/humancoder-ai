{
  "name": "humancoder-ai",
  "version": "0.1.0",
  "private": true,
  "description": "Chrome extension: an AI coding agent (via OpenRouter) that edits web code editors through a restricted, validated action set and a natural typing engine.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "tsc --noEmit && node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/extension.e2e.mjs",
    "test:e2e:background": "node tests/e2e/background-tab.e2e.mjs",
    "serve:test": "node scripts/serve-test.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "package": "npm run build && node scripts/package.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
